		<None Remove="UI\Controls\ItemListViewArtist.xaml" />
		<None Remove="UI\Controls\ItemListViewPlayList.xaml" />
		<None Remove="UI\Controls\ItemListViewSearch.xaml" />
		<None Remove="UI\Controls\KeyControl.xaml" />
		<None Remove="UI\Controls\LoadingTip.xaml" />
		<None Remove="UI\Controls\LyricItem.xaml" />
		<None Remove="UI\Controls\MainMusicDataItem.xaml" />
		<None Remove="UI\Controls\ManageLocalMusicFolderControl.xaml" />
		<None Remove="UI\Controls\MediaPlayStateViewer.xaml" />
		<None Remove="UI\Controls\MusicDataFlyout.xaml" />
		<None Remove="UI\Controls\MusicDataItem.xaml" />
		<None Remove="UI\Controls\NotifyItem.xaml" />
		<None Remove="UI\Controls\PlayListCard.xaml" />
		<None Remove="UI\Controls\ScrollFootButton.xaml" />
		<None Remove="UI\Controls\ScrollViewerSearchControl.xaml" />
		<None Remove="UI\Controls\SongHistoryCard.xaml" />
		<None Remove="UI\Controls\SongHistoryInfo.xaml" />
		<None Remove="UI\Controls\ImageEx.xaml" />
		<None Remove="DesktopLyricWindow.xaml" />
		<None Remove="UI\Pages\BrowsePage.xaml" />
		<None Remove="UI\Pages\DialogPages\AddFilesToMusicListDataPage.xaml" />
		<None Remove="UI\Pages\DialogPages\AddPlayListPage.xaml" />
