<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Product>TewiMP</Product>
		<Title>TewiMP</Title>
		<Version>0.0.7.1</Version>
		<AssemblyVersion>0.0.7.1</AssemblyVersion>
		<FileVersion>0.0.7.1</FileVersion>
		<VersionPrefix>0.0.7.1</VersionPrefix>
		<VersionSuffix>beta</VersionSuffix>
		<Company>TewiStudio</Company>
		<Authors>TewiStudio</Authors>
		<Copyright>© 2026 TewiStudio. All Rights Reserved.</Copyright>
		<PackageProjectUrl>https://github.com/TewiStudio/TewiMP</PackageProjectUrl>
	</PropertyGroup>
	<PropertyGroup>
		<RootNamespace>TewiMP</RootNamespace>
		<AssemblyName>TewiMP</AssemblyName>
		<OutputType>WinExe</OutputType>
		<WindowsSdkPackageVersion>10.0.22621.56</WindowsSdkPackageVersion>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<NeutralLanguage>zh-CN</NeutralLanguage>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<PublishTrimmed>False</PublishTrimmed>
		<PublishAot>False</PublishAot>
		<ApplicationIcon>Assets\Images\Icons\icon.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ImplicitUsings>disable</ImplicitUsings>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|arm64'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
	  <DebugType>embedded</DebugType>
	  <Optimize>True</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
	  <DebugType>embedded</DebugType>
	  <Optimize>True</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|arm64'">
	  <DebugType>embedded</DebugType>
	  <Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Background.zip" />
		<None Remove="UI\Controls\DownloadCard.xaml" />
