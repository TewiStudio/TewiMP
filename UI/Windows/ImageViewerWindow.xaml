<Window
    x:Class="TewiMP.UI.Windows.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TewiMP.UI.Windows"
    mc:Ignorable="d">
    <Grid KeyDown="ImageScrollView_KeyDown" KeyUp="ImageScrollView_KeyUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1" x:Name="ImageScrollView"
                      CanContentRenderOutsideBounds="False"
                      ZoomMode="Enabled"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      ViewChanged="ScrollViewer_ViewChanged"
                      IsVerticalRailEnabled="False"
                      IsHorizontalRailEnabled="False">
            <Image x:Name="ImageControl"
                   Margin="0,-32,0,0">
                <Image.Source>
                    <BitmapImage x:Name="ImageControl_Source"/>
                </Image.Source>
            </Image>
        </ScrollViewer>
        <Grid x:Name="TitleBar"
              VerticalAlignment="Top" Height="32" BorderThickness="0,0,0,1"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="TitleTextblock" VerticalAlignment="Center" Margin="0,0,138,0" Padding="18,8,0,8" TextTrimming="WordEllipsis"/>
        </Grid>

        <Grid Grid.Row="3" Padding="6" BorderThickness="0,1,0,0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Padding" Value="11,7,11,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
                <Style TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}">
                    <Setter Property="Padding" Value="11,7,11,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Style>
            </Grid.Resources>

            <StackPanel x:Name="ToolBarGrid"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                <Button Content="1:1" Click="Button_Click_1" Tag="0"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <RepeatButton HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Click="RepeatButton_Click" Tag="1">
                        <FontIcon Glyph="&#xE949;"
                              FontSize="16"/>
                    </RepeatButton>
                    <TextBlock Text="100%" Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               x:Name="ZoomTextBlock"/>
                    <RepeatButton VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"
                                  Grid.Column="2"
                                  Click="RepeatButton_Click" Tag="2">
                        <FontIcon Glyph="&#xE948;"
                                  FontSize="16"/>
                    </RepeatButton>
                </StackPanel>
            </StackPanel>

            <Button Padding="12,7,12,8"
                    Click="Button_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <FontIcon Glyph="&#xE78C;" FontSize="16"/>
                    <TextBlock Text="保存到文件..."/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
