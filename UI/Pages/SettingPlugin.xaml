<Page
    x:Class="TewiMP.UI.Pages.SettingPlugin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="using:TewiMP.Services.Plugin"
    xmlns:local="using:TewiMP.UI.Pages"
    xmlns:controls="using:TewiMP.UI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:cc="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d" Loaded="Page_Loaded">

    <Page.Resources>
        <Style TargetType="cc:SettingsExpander">
            <Setter Property="Margin" Value="0,4,4,0"/>
        </Style>
        <DataTemplate x:Key="PluginDataTemplate" x:DataType="plugin:Plugin">
            <cc:SettingsCard 
                Header="{Binding PluginInfo.Name}"
                Description="{Binding PluginInfo.Author}"
                DataContextChanged="SettingsCard_DataContextChanged"
                IsClickEnabled="True"
                ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                Click="SettingsCard_Click_1"/>
        </DataTemplate>
    </Page.Resources>
    
    <ListView x:Name="ListViewBase" HorizontalContentAlignment="Center" SelectionMode="None" Padding="0,0,0,12">

        <ListView.Header>
            <controls:StickTitleHeader Title="插件设置">
                <controls:StickTitleHeader.CommandBar>
                    <CommandBar VerticalAlignment="Bottom" Margin="0,0,10,0"
                                OverflowButtonVisibility="Auto" DefaultLabelPosition="Right">
                        <AppBarButton Label="浏览插件文件夹" AccessKey="R" Click="SettingsCard_Click_2"
                                      Icon="{ui:FontIcon Glyph=&#xE8DE;}"/>
                        <AppBarButton Label="重新加载插件" AccessKey="R" Click="SettingsCard_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72C;"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </controls:StickTitleHeader.CommandBar>
            </controls:StickTitleHeader>
        </ListView.Header>

        <cc:SettingsExpander
            x:Name="PluginMusicSource"
            Header="歌曲源插件"
            IsExpanded="True"
            ItemTemplate="{StaticResource PluginDataTemplate}">
        </cc:SettingsExpander>

        <cc:SettingsExpander
            x:Name="PluginOther"
            Header="其它插件"
            IsExpanded="True"
            ItemTemplate="{StaticResource PluginDataTemplate}">
        </cc:SettingsExpander>

        <Button Style="{StaticResource TextBlockButtonStyle}"
                Content="制作插件示例"
                Click="Button_Click"
                Margin="0,0,0,0"/>
    </ListView>
</Page>
