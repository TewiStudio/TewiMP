<Page
    x:Class="TewiMP.UI.Pages.SettingEqPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:m="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:controlsPrimitives="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:TewiMP.UI.Pages"
    xmlns:controls="using:TewiMP.UI.Controls"
    xmlns:data="using:TewiMP.Core.Audio"
    xmlns:dialogs="using:TewiMP.UI.Pages.DialogPages"
    mc:Ignorable="d"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Page.Resources>
        <local:ThumbToolTipValueConverter x:Key="thumbToolTipValueC"/>
        <local:EqIconOpacityValueConverter x:Key="eqIconOpacityValueC"/>
        <Style x:Key="CardHeader" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <ui:TransitionHelper x:Key="MyTransitionHelper"
                             Duration="0:0:0.5">
            <ui:TransitionConfig Id="background"
                                 ScaleMode="Scale" />
            <ui:TransitionConfig Id="image"
                                 ScaleMode="Scale" />
            <ui:TransitionConfig EnableClipAnimation="true"
                                 Id="desc" />
        </ui:TransitionHelper>

    </Page.Resources>

    <Grid>
        <ListView
            x:Name="ListViewBase"
            HorizontalContentAlignment="Center"
            SelectionMode="None"
            Padding="0,0,0,6">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MaxWidth" Value="1000"/>
                    <Setter Property="Margin" Value="0,2,4,2"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.Header>
                <Grid>
                    <controls:StickTitleHeader Title="音效" VerticalAlignment="Top"/>
                    <controls:StickVerticalBottom Opacity="1">
                        <Border 
                            Width="140" Height="70"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,8">
                            <Grid
                                x:Name="tSpectrumRoot"
                                ui:TransitionHelper.Id="background"
                                CornerRadius="4"
                                BorderThickness="0"
                                Background="{ThemeResource AcrylicNormal}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button
                                    x:Name="spectrumButton"
                                    Padding="0"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="展开图形均衡器频谱"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                    <i:Interaction.Behaviors>
                                        <i:EventTriggerBehavior EventName="Click">
                                            <ui:StartTransitionAction
                                                Source="{Binding ElementName=tSpectrumRoot}"
                                                Target="{Binding ElementName=AudioSpectrumRoot}"
                                                Transition="{StaticResource MyTransitionHelper}" />
                                        </i:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                    <controls:AudioSpectrum
                                        x:Name="spectrumCanvas"
                                        ui:TransitionHelper.Id="image"
                                        Background="Transparent"
                                        StrokeWidth="0"
                                        SmoothingUpFactor=".1"
                                        SmoothingDownFactor=".1"
                                        DrawEqLines="True"
                                        DrawEqLinesStrokeWidth="1"
                                        DrawEqPoints="True"
                                        DrawEqPointsRadius="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                                </Button>
                                <FontIcon
                                    IsHitTestVisible="False" Glyph="&#xE740;" FontSize="15"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="9" Opacity=".6"/>
                            </Grid>
                        </Border>
                    </controls:StickVerticalBottom>
                </Grid>
            </ListView.Header>

            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </ListView.ItemContainerTransitions>

            <controlsPrimitives:SettingsCard
                Header="音效总开关">
                <ToggleSwitch
                    x:Name="EqEnableSwitcher"
                    IsEnabled="True"
                    IsOn="{x:Bind EqEnabled,Mode=TwoWay}"/>
            </controlsPrimitives:SettingsCard>

            <!--图形均衡器-->
            <controlsPrimitives:SettingsExpander
                Header="图形均衡器"
                Description="使用图形均衡器设置">
                <ToggleSwitch
                    x:Name="GraphicEqToggleButton"
                    Toggled="GraphicEqToggleButton_Toggled"/>
                <controlsPrimitives:SettingsExpander.Items>
                    <controlsPrimitives:SettingsCard
                        Header="预设">
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Spacing="8">
                            <Button
                                x:Name="GraphicResetButton"
                                Content="重置"
                                Visibility="Visible"
                                IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}"
                                Click="GraphicResetButton_Click"/>
                            <ComboBox
                                x:Name="GraphicEqComboBox"
                                SelectionChanged="GraphicEqComboBox_SelectionChanged"
                                Loaded="GraphicEqComboBox_Loaded"
                                IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}">
                                <x:String>自定义</x:String>
                                <x:String>高音增强</x:String>
                                <x:String>低音增强</x:String>
                                <x:String>头戴式耳机</x:String>
                                <x:String>笔记本电脑</x:String>
                                <x:String>便携式扬声器</x:String>
                                <x:String>家庭立体声</x:String>
                                <x:String>电视</x:String>
                                <x:String>汽车</x:String>
                            </ComboBox>
                        </StackPanel>
                    </controlsPrimitives:SettingsCard>
                    <controlsPrimitives:SettingsCard>
                        <controlsPrimitives:SettingsCard.Description>
                            <Grid HorizontalAlignment="Left" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <!--<TextBlock Text="分贝" FlowDirection="RightToLeft" HorizontalAlignment="Left"/>-->
                                <Grid Width="38" HorizontalAlignment="Left" Margin="0,0,0,0" Grid.Row="1">
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FlowDirection" Value="RightToLeft"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Opacity"
                                            Value="{Binding ElementName=GraphicEqToggleButton,Path=IsOn,Converter={StaticResource eqIconOpacityValueC}}"/>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock x:Name="EqFirstTextBlock" Text="12+" Margin="0,10,0,0" Opacity="1"/>
                                    <TextBlock Text="6+" Margin="0,38,0,0" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                    <TextBlock Text="0" Margin="0,70,0,0" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                    <TextBlock Text="6-" Margin="0,100,0,0" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                    <TextBlock Text="12-" Margin="0,132,0,0" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                    <TextBlock Text="db/Hz" Margin="0,158,0,0" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                </Grid>
                                <ScrollViewer 
                                    Padding="0,0,0,12" Margin="46,0,0,0" Grid.Row="1"
                                    VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                                    <Grid Padding="0,2,0,2">
                                        <StackPanel x:Name="SliderStackBase" Orientation="Horizontal" Margin="0,8,0,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                                </Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                                </Style>
                                                <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                                                    <Setter Property="Orientation" Value="Vertical"/>
                                                    <Setter Property="Height" Value="140"/>
                                                    <Setter Property="TickPlacement" Value="Outside"/>
                                                    <Setter Property="TickFrequency" Value="30"/>
                                                    <Setter Property="Maximum" Value="120"/>
                                                    <Setter Property="Minimum" Value="-120"/>
                                                    <Setter Property="Value" Value="0"/>
                                                    <Setter Property="ThumbToolTipValueConverter" Value="{StaticResource thumbToolTipValueC}"/>
                                                </Style>
                                            </StackPanel.Resources>
                                            <StackPanel>
                                                <Slider x:Name="Eq0" AccessKey="1" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="31" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq1" AccessKey="2" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="62" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq2" AccessKey="3" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="125" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq3" AccessKey="4" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="250" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq4" AccessKey="5" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="500" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq5" AccessKey="6" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="1k" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq6" AccessKey="7" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="2k" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq7" AccessKey="8" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="4k" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq8" AccessKey="9" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="8k" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <Slider x:Name="Eq9" AccessKey="0" IsEnabled="{Binding ElementName=GraphicEqToggleButton, Path=IsOn}" ValueChanged="GraphicEQSlider_ValueChanged"/>
                                                <TextBlock Text="16k" Opacity="{Binding ElementName=EqFirstTextBlock,Path=Opacity}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </controlsPrimitives:SettingsCard.Description>
                    </controlsPrimitives:SettingsCard>
                </controlsPrimitives:SettingsExpander.Items>
            </controlsPrimitives:SettingsExpander>

            <!--参数均衡器-->
            <controlsPrimitives:SettingsExpander
                Header="参数均衡器"
                Description="使用参数均衡器设置">
                <ToggleSwitch
                    x:Name="ParametricToggleButton"
                    Toggled="ParametricToggleButton_Toggled"/>
                <controlsPrimitives:SettingsExpander.Items>
                    <controlsPrimitives:SettingsCard Padding="0">
                        <controlsPrimitives:SettingsCard.Description>
                            <StackPanel 
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,-24,0">
                                
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <RepositionThemeTransition />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <ListView
                                    x:Name="EQList"
                                    Loading="EQList_Loading"
                                    DragItemsCompleted="ListViewBase_DragItemsCompleted"
                                    IsEnabled="{Binding ElementName=ParametricToggleButton, Path=IsOn}"
                                    ItemContainerStyle="{StaticResource NoPaddingListViewItemStyle}"
                                    CanDragItems="True" AllowDrop="True"
                                    CanReorderItems="True" SelectionMode="None"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="data:EQData">
                                            <controls:EQCard Margin="0,0,0,0"/>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    IsEnabled="{Binding ElementName=ParametricToggleButton, Path=IsOn}"
                                    CornerRadius="0,0,4,4" BorderThickness="0"
                                    Padding="16"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Click="Button_Click">
                                    <StackPanel>
                                        <Grid>
                                            <Path
                                                Data="{ThemeResource 音波}"
                                                Width="30"
                                                Height="30"
                                                Stretch="Uniform"
                                                Fill="{ThemeResource ButtonForegroundThemeBrush}"
                                                Opacity="{Binding ElementName=ParametricToggleButton,Path=IsOn,Converter={StaticResource eqIconOpacityValueC}}"/>
                                            <TextBlock
                                                x:Name="EqAddFreTextBlock"
                                                Text="+"
                                                Margin="4,14,0,0"
                                                FontSize="24"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock
                                            Text="添加频段"
                                            TextAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controlsPrimitives:SettingsCard.Description>
                    </controlsPrimitives:SettingsCard>
                </controlsPrimitives:SettingsExpander.Items>
            </controlsPrimitives:SettingsExpander>

            <!--滤波器-->
            <controlsPrimitives:SettingsExpander
                Header="滤波器"
                Description="使用滤波器设置">
                <ToggleSwitch
                    x:Name="PassFilterToggleButton"
                    Toggled="PassFilterToggleButton_Toggled"/>
                <controlsPrimitives:SettingsExpander.Items>
                    <controlsPrimitives:SettingsCard Padding="12">
                        <controlsPrimitives:SettingsCard.Description>
                            <ScrollViewer
                                HorizontalScrollMode="Enabled"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Disabled">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <ListView
                                        x:Name="PassFilterList"
                                        IsEnabled="{Binding ElementName=PassFilterToggleButton, Path=IsOn}"
                                        CanDragItems="True" AllowDrop="True"
                                        CanReorderItems="True" SelectionMode="None"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="data:PassFilterData">
                                                <controls:PassFilterCard Margin="0,0,0,0"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        IsEnabled="{Binding ElementName=PassFilterToggleButton, Path=IsOn}"
                                        CornerRadius="8"
                                        Padding="16" Margin="12,0"
                                        Width="120" Height="120"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Click="Button_Click_1">
                                        <Button.Transitions>
                                            <TransitionCollection>
                                                <RepositionThemeTransition/>
                                            </TransitionCollection>
                                        </Button.Transitions>
                                        <StackPanel>
                                            <TextBlock
                                                Text="+"
                                                FontSize="38"
                                            TextAlignment="Center"/>
                                            <TextBlock
                                                Text="添加滤波器"
                                                TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </controlsPrimitives:SettingsCard.Description>
                    </controlsPrimitives:SettingsCard>
                </controlsPrimitives:SettingsExpander.Items>
            </controlsPrimitives:SettingsExpander>

            <!--预设-->
            <controlsPrimitives:SettingsExpander
                Header="参数均衡器 &amp; 滤波器 预设"
                Description="管理 参数均衡器 &amp; 滤波器 的设置预设">
                <ComboBox
                    x:Name="ParamEQComboBox"
                    SelectedIndex="0">
                    <x:String>默认</x:String>
                </ComboBox>
                <controlsPrimitives:SettingsExpander.Items>
                    <controlsPrimitives:SettingsCard
                        Header="保存当前设置为预设">
                        <Button Content="保存"/>
                    </controlsPrimitives:SettingsCard>
                    <controlsPrimitives:SettingsCard
                        Header="AutoEq"
                        Description="搜索 AutoEq 预设">
                        <Button Content="搜索"/>
                    </controlsPrimitives:SettingsCard>
                </controlsPrimitives:SettingsExpander.Items>

            </controlsPrimitives:SettingsExpander>
        </ListView>

        <Grid
            ui:TransitionHelper.Id="background"
            Visibility="Collapsed"
            Margin="0,0,0,0" CornerRadius="0" BorderThickness="0,0,0,0"
            Background="{ThemeResource AcrylicNormal}"
            BorderBrush="{ThemeResource ControlStrokeColorOnAccentTertiaryBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            x:Name="AudioSpectrumRoot">
            <Grid Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <controls:AudioSpectrum
                    x:Name="AudioSpectrum"
                    SmoothWindow="2" MaxFreq="22000"
                    SampleCount="1024" StrokeWidth="1"
                    DrawDbLines="True" DrawEqLines="True" DrawEqPoints="True" DrawLatencyText="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ui:TransitionHelper.Id="image"/>
                <controlsPrimitives:RangeSelector
                    Minimum="20" Maximum="22000" Visibility="Visible"
                    Grid.Row="1" Margin="12,0"
                    RangeStart="{x:Bind AudioSpectrum.MinFreq, Mode=TwoWay}"
                    RangeEnd="{x:Bind AudioSpectrum.MaxFreq, Mode=TwoWay}"/>
            </Grid>
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16,8" Spacing="4">
                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="36"/>
                        <Setter Property="Height" Value="36"/>
                    </Style>
                </StackPanel.Resources>
                <Button
                    Width="36" Height="36" Padding="9"
                    ToolTipService.ToolTip="频谱设置">
                    <Button.Flyout>
                        <Flyout Placement="Right"
                                ShouldConstrainToRootBounds="False">
                            <ScrollViewer>
                                <StackPanel Orientation="Vertical" Margin="4,0,16,0" Width="250">
                                    <Slider Header="透明度" Minimum="0" Maximum="1" Value="{x:Bind AudioSpectrum.Opacity, Mode=TwoWay}" StepFrequency="0.01"/>
                                    <Slider Header="线段宽度" Minimum="0" Maximum="10.0" Value="{x:Bind AudioSpectrum.StrokeWidth, Mode=TwoWay}" StepFrequency="0.1"/>
                                    <Slider Header="斜率(dB/oct)" Minimum="-6" Maximum="6" Value="{x:Bind AudioSpectrum.TiltDbPerOct, Mode=TwoWay}" StepFrequency="0.1"/>
                                    <Slider Header="下降平滑系数" Minimum=".05" Maximum="1.0" Value="{x:Bind AudioSpectrum.SmoothingDownFactor, Mode=TwoWay}" StepFrequency="0.01"/>
                                    <Slider Header="上升平滑系数" Minimum=".05" Maximum="1.0" Value="{x:Bind AudioSpectrum.SmoothingUpFactor, Mode=TwoWay}" StepFrequency="0.01"/>
                                    <Slider Header="滑动窗口平滑" Minimum="1" Maximum="100" Value="{x:Bind AudioSpectrum.SmoothWindow, Mode=TwoWay}" StepFrequency="1"/>
                                    <Slider Header="采样数" Minimum="3" Maximum="4096" Value="{x:Bind AudioSpectrum.SampleCount, Mode=TwoWay}" StepFrequency="1"/>
                                    <Slider Header="均衡器影响曲线宽度" Minimum="0" Maximum="10.0" Value="{x:Bind AudioSpectrum.DrawEqLinesStrokeWidth, Mode=TwoWay}" StepFrequency="0.1"/>
                                    <Slider Header="均衡器控制点半径" Minimum="0" Maximum="20.0" Value="{x:Bind AudioSpectrum.DrawEqPointsRadius, Mode=TwoWay}" StepFrequency="0.1"/>
                                    <Slider Header="绘制比例" Minimum="0.1" Maximum="4.0" Value="{x:Bind AudioSpectrum.DrawScale, Mode=TwoWay}" StepFrequency="0.1"/>
                                    <controlsPrimitives:HeaderedItemsControl 
                                        Header="最小/最大频率(Hz)">
                                        <controlsPrimitives:RangeSelector
                                            Minimum="20" Maximum="22000" Visibility="Visible"
                                            RangeStart="{x:Bind AudioSpectrum.MinFreq, Mode=TwoWay}"
                                            RangeEnd="{x:Bind AudioSpectrum.MaxFreq, Mode=TwoWay}"/>
                                    </controlsPrimitives:HeaderedItemsControl>
                                    <CheckBox IsChecked="{x:Bind AudioSpectrum.DrawDbLines, Mode=TwoWay}" Content="绘制分贝/频率线条"/>
                                    <CheckBox IsChecked="{x:Bind AudioSpectrum.DrawEqLines, Mode=TwoWay}" Content="绘制均衡器影响曲线"/>
                                    <CheckBox IsChecked="{x:Bind AudioSpectrum.DrawEqPoints, Mode=TwoWay}" Content="绘制均衡器控制点"/>
                                    <CheckBox IsChecked="{x:Bind AudioSpectrum.DrawLatencyText, Mode=TwoWay}" Content="绘制帧数/延迟标签"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                    <AnimatedIcon>
                        <AnimatedIcon.Source>
                            <m:AnimatedSettingsVisualSource/>
                        </AnimatedIcon.Source>
                    </AnimatedIcon>
                </Button>
                <Button
                    Content="{ui:FontIcon FontSize=16, Glyph=&#xE73F;}"
                    Padding="0" Width="36" Height="36" ToolTipService.ToolTip="缩小">
                    <i:Interaction.Behaviors>
                        <i:EventTriggerBehavior EventName="Click">
                            <ui:ReverseTransitionAction Transition="{StaticResource MyTransitionHelper}" />
                        </i:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                </Button>
                <ToggleButton 
                    HorizontalAlignment="Right" Width="36" Height="36" Padding="0"
                    Content="{ui:FontIcon FontSize=16, Glyph=&#xE7E8;}"
                    IsChecked="{x:Bind EqEnabled, Mode=TwoWay}" ToolTipService.ToolTip="音效总开关"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
