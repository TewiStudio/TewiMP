<Page
    x:Class="TewiMP.UI.Pages.ListViewPages.PlayListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:c="using:CommunityToolkit.WinUI"
    xmlns:cmedia="using:CommunityToolkit.WinUI.Media"
    xmlns:op="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:TewiMP.Core.Models"
    xmlns:data="using:TewiMP.Services.Storage"
    xmlns:controls="using:TewiMP.UI.Controls"
    xmlns:local="using:TewiMP.UI.Pages.ListViewPages"
    mc:Ignorable="d"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    SizeChanged="Page_SizeChanged" ActualThemeChanged="Page_ActualThemeChanged">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentColorBrush" Color="{StaticResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="AccentColorBrushDark1" Color="{StaticResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="AccentColorBrushDark2" Color="{StaticResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TextOnAccentColorBrush" Color="{StaticResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TextOnAccentColorBrushDark1" Color="{StaticResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TextOnAccentColorBrushDark2" Color="{StaticResource SystemAccentColor}"/>
    </Page.Resources>

    <Grid x:Name="root">
        <ListView
            x:Name="ItemsList"
            SelectionMode="None"
            UseLayoutRounding="True"
            Padding="0,0,0,58"
            ItemContainerStyle="{StaticResource NoPaddingListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:MusicDataViewModel">
                    <controls:MusicDataItem Margin="16,1" ViewModel="{x:Bind}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Header>
                <Grid
                    x:Name="ItemsList_Header_Root"
                    Margin="0,0,0,0"
                    VerticalAlignment="Top">
                    <Border
                        x:Name="ItemsList_Header_ImageInfo_BackgroundFill"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1" Margin="-4,-4,-4,0"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        c:Effects.Shadow="{StaticResource CommonHeaderShadow}"/>
                    <Grid x:Name="ItemsList_Header_Info_Base" Margin="16">
                        <Grid
                            x:Name="ItemsList_Header_Image_Root"
                            SizeChanged="ItemsList_Header_Image_Root_SizeChanged"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Height="280">
                            <Rectangle x:Name="ItemsList_Header_Image_Shadow"/>
                            <controls:ImageEx
                                x:Name="ItemsList_Header_Image"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="0">
                                <c:Effects.Shadow>
                                    <c:AttachedDropShadow BlurRadius="50" Color="#30000000" CastTo="{x:Bind ItemsList_Header_Image_Shadow}" Offset="0,3"/>
                                </c:Effects.Shadow>
                            </controls:ImageEx>
                        </Grid>
                        <Grid x:Name="ItemsList_Header_Info_Root">
                            <Grid 
                                x:Name="ItemsList_Header_Info_Root_SizeChanger"
                                HorizontalAlignment="Left">
                                <StackPanel x:Name="ItemsList_Header_Info_StackPanel">
                                    <controls:AutoScrollView>
                                        <TextBlock
                                            x:Name="ItemsList_Header_Info_TitleTextBlock"
                                            Text="Title"
                                            Style="{ThemeResource SubTBHeader}"/>
                                    </controls:AutoScrollView>
                                    <TextBlock x:Name="ItemsList_Header_Info_OtherTextBlock" Text="Other"/>
                                </StackPanel>
                                <CommandBar
                                    x:Name="ItemsList_Header_Info_CommandBar"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    DefaultLabelPosition="Right"
                                    Margin="0,0,0,0"
                                    AccessKey="Z">
                                    <CommandBar.SecondaryCommands>
                                        <AppBarButton
                                            Label="搜索"
                                            AccessKey="F"
                                            ToolTipService.ToolTip="搜索播放列表中的歌曲"
                                            Click="AppBarButton_Click" Tag="search">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE721;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Label="添加本地文件"
                                            AccessKey="A"
                                            ToolTipService.ToolTip="添加本地文件"
                                            Click="AppBarButton_Click" Tag="addLocal">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE8E5;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            x:Name="editButton"
                                            Label="编辑播放列表"
                                            AccessKey="A"
                                            Icon="Edit"
                                            ToolTipService.ToolTip="添加本地文件"
                                            Click="AppBarButton_Click" Tag="edit_list">
                                        </AppBarButton>

                                        <AppBarButton
                                            Click="multiButton_Click"
                                            Tag="multi_deleteSelect"
                                            Label="移除选中歌曲"
                                            ToolTipService.ToolTip="从此列表中移除选中歌曲">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE74D;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Click="multiButton_Click"
                                            Tag="multi_downloadSelect"
                                            Label="下载选中歌曲"
                                            ToolTipService.ToolTip="下载选中歌曲">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xE896;"/>
                                            </AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton
                                            Click="multiButton_Click"
                                            Tag="multi_addSelectToPlayList"
                                            Label="添加选中歌曲到播放列表中"
                                            ToolTipService.ToolTip="添加选中歌曲到播放列表中">
                                            <AppBarButton.Flyout>
                                                <MenuFlyout Opening="multi_addSelectToPlayList_flyout_Opening" Closed="multi_addSelectToPlayList_flyout_Closed"/>
                                            </AppBarButton.Flyout>
                                            <Viewbox Width="9" Margin="2,0,0,0">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE710;" Scale="0.47,0.47,1" Margin="-10,-2,0,0"
                                                        VerticalAlignment="Top"/>
                                                    <FontIcon Glyph="&#xE90B;"
                                                        VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Viewbox>
                                        </AppBarButton>
                                        <AppBarButton
                                            Click="multiButton_Click"
                                            Tag="multi_addSelectToPlaying"
                                            Label="添加选中歌曲到正在播放的列表中"
                                            ToolTipService.ToolTip="添加选中歌曲到正在播放的列表中">
                                            <Viewbox Width="9" Margin="2,0,0,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE710;" Scale="0.47,0.47,1" Margin="-10,-2,0,0"
                                                        VerticalAlignment="Top"/>
                                                    <FontIcon Glyph="&#xEE4A;"
                                                        VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Viewbox>
                                        </AppBarButton>

                                        <AppBarElementContainer 
                                            AllowFocusOnInteraction="True"
                                            x:Name="SortComboBoxParent">
                                            <ComboBox
                                                x:Name="SortComboBox"
                                                SelectionChanged="SortComboBox_SelectionChanged"
                                                Header="排序方式"
                                                AccessKey="X"
                                                Margin="12,4">
                                            </ComboBox>
                                        </AppBarElementContainer>
                                    </CommandBar.SecondaryCommands>

                                    <AppBarButton
                                        x:Name="PlayAllButton"
                                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Label="全部播放（Alt+Q）"
                                        AccessKey="Q"
                                        ToolTipService.ToolTip="播放歌单内的所有歌曲"
                                        Click="AppBarButton_Click" Tag="playAll">
                                        <AppBarButton.Resources>
                                            <StaticResource x:Key="AppBarButtonBackground" ResourceKey="AccentColorBrush" />
                                            <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="AccentColorBrushDark1" />
                                            <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="AccentColorBrushDark2" />
                                            <StaticResource x:Key="AppBarButtonForeground" ResourceKey="TextOnAccentColorBrush" />
                                            <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="TextOnAccentColorBrushDark1" />
                                            <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="TextOnAccentColorBrushDark2" />
                                        </AppBarButton.Resources>
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xEE4A;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Label="刷新"
                                        AccessKey="R"
                                        ToolTipService.ToolTip="刷新"
                                        Click="AppBarButton_Click" Tag="refresh">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE72C;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarToggleButton
                                        Click="AppBarToggleButton_Click"
                                        Label="多选" Tag="multiSelect"
                                        AccessKey="S"
                                        ToolTipService.ToolTip="多选">
                                        <AppBarToggleButton.Icon>
                                            <FontIcon Glyph="&#xE762;"/>
                                        </AppBarToggleButton.Icon>
                                    </AppBarToggleButton>
                                    <AppBarToggleButton
                                        Click="AppBarToggleButton_Click"
                                        Label="排序" Tag="move" x:Name="moveButton"
                                        AccessKey="D"
                                        ToolTipService.ToolTip="拖动音乐控件以重新排序">
                                        <AppBarToggleButton.Icon>
                                            <FontIcon Glyph="&#xEA37;"/>
                                        </AppBarToggleButton.Icon>
                                    </AppBarToggleButton>

                                    <AppBarButton
                                        Click="multiButton_Click"
                                        Tag="multi_selectAll"
                                        Label="选中全部"
                                        ToolTipService.ToolTip="选中全部">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE8B3;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Click="multiButton_Click"
                                        Tag="multi_selectReverse"
                                        Label="反选"
                                        ToolTipService.ToolTip="反选">
                                        <AppBarButton.Icon>
                                            <PathIcon Data="{StaticResource 反选}"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton
                                        Click="AppBarButton_Click"
                                        Label="取消更改" Tag="move_Cancel">
                                        <AppBarButton.Icon>
                                            <FontIcon Glyph="&#xE711;"/>
                                        </AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ItemsList_Header_Foot_Root">
                        <controls:ScrollFootButton
                            x:Name="ItemsList_Header_Foot_Buttons"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            PositionButtonClick="ItemsList_Header_Foot_Buttons_PositionButtonClick"/>
                    </Grid>
                    <Grid 
                        x:Name="ItemList_Header_Search_Root"
                        VerticalAlignment="Bottom" >
                        <controls:ScrollViewerSearchControl
                            x:Name="ItemList_Header_Search_Control"
                            Margin="16,0" IsOpen="False"/>
                    </Grid>
                </Grid>
            </ListView.Header>
            <ListView.Footer>
                <Grid>
                    <TextBlock
                        Text="到底了~" Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="4,4,4,50" x:Name="AtListBottomTb"
                        Foreground="{ThemeResource TextFillColorSecondary}"/>
                </Grid>
            </ListView.Footer>
        </ListView>
        <controls:LoadingTip x:Name="LoadingTipControl"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,54"/>
    </Grid>
</Page>
