<UserControl
    x:Class="TewiMP.UI.Controls.LogItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TewiMP.UI.Controls"
    xmlns:background="using:TewiMP.Core"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    mc:Ignorable="d"
    DataContextChanged="UserControl_DataContextChanged"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    ActualThemeChanged="UserControl_ActualThemeChanged">
    <Grid>
        <TextBlock
            x:Name="t2" Grid.Row="1"
            IsTextSelectionEnabled="True"
            TextWrapping="WrapWholeWords"
            Padding="12,0">
            <Run x:Name="t1_1"/><Run x:Name="t1_2"/><Run x:Name="t2_1"/><Run x:Name="t2_2"/>
        </TextBlock>
    </Grid>
</UserControl>
