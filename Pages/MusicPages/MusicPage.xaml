<Page
    x:Class="TewiMP.Pages.MusicPages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TewiMP"
    xmlns:binding="using:TewiMP.Helpers"
    xmlns:data="using:TewiMP.Core.Models"
    xmlns:controls="using:TewiMP.Controls"
    xmlns:uis="using:CommunityToolkit.WinUI"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"    
    xmlns:brush="using:CommunityToolkit.WinUI.Media"
    xmlns:m="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    x:Name="pageRoot" Loaded="pageRoot_Loaded" x:FieldModifier="Public"
    ActualThemeChanged="pageRoot_ActualThemeChanged"
    mc:Ignorable="d" Opacity="1" IsHitTestVisible="True">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SystemAccentColor}"/>
        <StaticResource x:Key="AccentBrushNormal" ResourceKey="MusicAlbumAccentBrush"/>
        <StaticResource x:Key="AccentBrushReverse" ResourceKey="MusicAlbumAccentBrushReverse"/>
        <DataTemplate x:Key="LyricTemplate" x:DataType="data:LyricData">
            <controls:LyricItem/>
        </DataTemplate>
        <Style TargetType="ListViewItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ListViewItemPresenter
                            BorderBrush="Transparent"
                            Background="{x:Null}"
                            Foreground="{ThemeResource MusicPageLrcForeground}"
                            SelectedForeground="{ThemeResource AccentBrush}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            SelectionCheckMarkVisualEnabled="False"
                            PlaceholderBackground="Transparent"
                            PointerOverBackground="Transparent"
                            PointerOverBorderBrush="Transparent"
                            SelectedBackground="Transparent"
                            SelectedPointerOverBackground="Transparent"
                            SelectedPressedBackground="Transparent"
                            PressedBackground="Transparent"
                            DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                            ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentMargin="{TemplateBinding Padding}"
                            CheckMode="Inline"
                            MinWidth="0"
                            Margin="0,0,0,40">
                        </ListViewItemPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="_pageRoot">
        <controls:MusicDataFlyout x:Name="MusicDataFlyout"/>
        <controls:ImageEx x:Name="BackgroundBaseImage" IsHitTestVisible="False"
                          VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="1"
                          Stretch="UniformToFill" Loaded="BackgroundBaseImage_Loaded"/>
        <TextBlock x:Name="BridgeTb" TextAlignment="Left" HorizontalAlignment="Left"/>
        <Grid Name="BackgroundFillBase" Background="Transparent"
              RightTapped="BackgroundFillBase_RightTapped">
            <Grid.OpacityTransition>
                <ScalarTransition/>
            </Grid.OpacityTransition>
            <Rectangle>
                <Rectangle.Fill>
                    <brush:BackdropBlurBrush Amount="50" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <!--<SolidColorBrush Color="#55000000"/>-->
                    <AcrylicBrush TintLuminosityOpacity="0.85" TintOpacity="0.0" FallbackColor="{ThemeResource MusicPageImageBlurFallbackColor}" TintColor="{ThemeResource BlurImageAcrylicBrush}" Opacity="1"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.0001"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height=".3*"/>
                </Grid.RowDefinitions>
                <controls:AudioSpectrum
                    Grid.Row="1" Opacity=".55" Margin="0,0,0,12" x:Name="AudioSpectrum1" DrawDbLines="False"
                    StrokeWidth=".2" SmoothingFactor=".15" SmoothWindow="2" SampleCount="256" TiltDbPerOct="-4.5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>
        <Grid Padding="0" x:Name="InterfaceBaseGrid">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25"/>
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Padding="38,54,38,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="InfoPageColumn"/>
                    <ColumnDefinition Width="1.4*" x:Name="LrcPageColumn"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="InfoBaseGrid" VerticalAlignment="Stretch" Margin="0,0,30,0" SizeChanged="MusicPage_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" x:Name="ImageVer"/>
                        <RowDefinition Height="*" x:Name="LyricSccondRow"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="AlbumImageBorder">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </Grid.Transitions>
                        <Border x:Name="AlbumImageShadowTarget"/>
                        <controls:ImageEx x:Name="AlbumImageBase" CornerRadius="8" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1">
                            <uis:Effects.Shadow>
                                <uis:AttachedDropShadow BlurRadius="60" Color="#50000000" CastTo="{x:Bind AlbumImageShadowTarget}"
                                                        Offset="0,3"/>
                            </uis:Effects.Shadow>
                        </controls:ImageEx>
                    </Grid>
                    <ui:OpacityMaskView x:Name="LyricSecondPlaceGrid"
                                        Margin="0,8,0,0" Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        SizeChanged="MusicPage_SizeChanged">
                        <ui:OpacityMaskView.OpacityMask>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset=".15" Color="White" />
                                        <GradientStop Offset=".85" Color="White" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </ui:OpacityMaskView.OpacityMask>
                        <ListView x:Name="LrcSecondListView"
                                  ItemsSource="{Binding ElementName=LrcBaseListView,Path=ItemsSource}"
                                  ItemTemplate="{ThemeResource LyricTemplate}"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  SelectionChanged="LrcBaseListView_SelectionChanged"
                                  SizeChanged="LrcBaseListView_SizeChanged"
                                  IsFocusEngagementEnabled="True"
                                  PointerWheelChanged="LrcSecondListView_PointerWheelChanged"
                                  Background="{x:Null}"/>
                    </ui:OpacityMaskView>
                    <StackPanel x:Name="InfoBaseTitle" Grid.Row="2" Loaded="InfoBaseTitle_Loaded"
                                Spacing="4" Margin="0,12,0,0" Visibility="Visible">
                        <StackPanel.Resources>
                            <Style TargetType="FontIcon">
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,2,0"/>
                                <Setter Property="Foreground" Value="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource ApplicationSecondaryForegroundThemeBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="Transitions">
                                    <Setter.Value>
                                        <TransitionCollection>
                                            <ContentThemeTransition/>
                                        </TransitionCollection>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="{x:Null}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="TitleRunButton" AccessKey="T" Click="TitleRunButton_Click">
                            <Button.Flyout>
                                <MenuFlyout x:Name="TitleFlyout" Opening="TitleFlyout_Opening">
                                    <MenuFlyoutItem IsEnabled="False" x:Name="TitleMenuFlyoutText"/>
                                    <MenuFlyoutItem x:Name="TitleSearchMenuItem" Click="TitleSearchMenuItem_Click" Text="去搜索" Icon="find"/>
                                    <MenuFlyoutItem x:Name="CopyMenuItem" Click="CopyMenuItem_Click" Text="复制" Icon="copy"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <controls:AutoScrollView x:Name="AutoScrollViewer2">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="TitleRunText" FontWeight="Bold" FontSize="24" Foreground="{ThemeResource ApplicationForegroundThemeBrush}"/>
                                    <TextBlock x:Name="Title2RunText" FontWeight="Bold" VerticalAlignment="Center" FontSize="22" Foreground="{ThemeResource ApplicationPressedForegroundThemeBrush}"/>
                                </StackPanel>
                            </controls:AutoScrollView>
                        </Button>
                        <Button x:Name="ArtistRunButton" AccessKey="A" Click="ArtistRunButton_Click">
                            <Button.Flyout>
                                <MenuFlyout x:Name="ArtistFlyout" Opening="ArtistFlyout_Opening"/>
                            </Button.Flyout>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE77B;"/>
                                <controls:AutoScrollView x:Name="AutoScrollViewer1" Grid.Column="1">
                                    <TextBlock x:Name="ArtistRunText" Text="Artist"/>
                                </controls:AutoScrollView>
                            </Grid>
                        </Button>
                        <Button x:Name="AlbumRunButton" AccessKey="B" Click="AlbumRunButton_Click">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AlbumFlyout" Opening="AlbumFlyout_Opening">
                                    <MenuFlyoutItem x:Name="AlbumMenuItem" Click="AlbumMenuItem_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE93C;"/>
                                <controls:AutoScrollView x:Name="AutoScrollViewer3" Grid.Column="1">
                                    <TextBlock x:Name="AlbumRunText" Text="Album"/>
                                </controls:AutoScrollView>
                            </Grid>
                        </Button>
                        <Button x:Name="OtherRunButton" AccessKey="O" Click="OtherRunButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8CE;"/>
                                <controls:AutoScrollView x:Name="AutoScrollViewer4" Grid.Column="1">
                                    <TextBlock x:Name="OtherRunText"/>
                                </controls:AutoScrollView>
                            </Grid>
                        </Button>
                        <Button x:Name="AudioInfoButton" AccessKey="I"  Click="AudioInfoButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xF120;"/>
                                <controls:AutoScrollView x:Name="AutoScrollViewer5" Grid.Column="1">
                                    <TextBlock x:Name="AudioInfoRunText" Text="{Binding App.Instance.audioPlayer}"/>
                                </controls:AutoScrollView>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="LyricBaseGrid" Grid.Column="1" Grid.Row="0">
                    <ui:OpacityMaskView x:Name="LrcBaseGrid">
                        <ui:OpacityMaskView.OpacityMask>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset=".15" Color="White" />
                                        <GradientStop Offset=".85" Color="White" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </ui:OpacityMaskView.OpacityMask>

                        <ListView x:Name="LrcBaseListView"
                                  Loaded="LrcBaseListView_Loaded"
                                  Background="{x:Null}"
                                  SelectionChanged="LrcBaseListView_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  IsFocusEngagementEnabled="True"
                                  SizeChanged="LrcBaseListView_SizeChanged"
                                  HorizontalContentAlignment="Stretch"
                                  ItemTemplate="{ThemeResource LyricTemplate}"
                                  PointerWheelChanged="LrcSecondListView_PointerWheelChanged">
                        </ListView>
                    </ui:OpacityMaskView>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Padding="36,0">
                <Grid x:Name="ControlBar" Padding="0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PositionGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NowPlayTimeTb"
                                   Text="00:00"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Grid.Column="0">
                            <TextBlock.Transitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <Slider x:Name="PlaySlider"
                                AccessKey="S"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                IsThumbToolTipEnabled="False"
                                Padding="12,0,12,0"
                                Grid.Column="1"
                                ValueChanged="PlaySlider_ValueChanged">
                            <Slider.Resources>
                                <brush:BackdropGammaTransferBrush x:Key="GammaBackground"
                                                                RedDisable="True" GreenDisable="True" BlueDisable="True"
                                                                AlphaAmplitude="1.2" AlphaExponent="1.2" AlphaOffset="1.2"/>
                                <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush"/>
                                <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentBrush"/>
                                <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentBrush"/>

                                <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush"/>
                                <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush"/>
                                <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush"/>

                                <StaticResource x:Key="SliderTrackFill" ResourceKey="GammaBackground"/>
                                <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="GammaBackground"/>
                                <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="GammaBackground"/>
                            </Slider.Resources>
                        </Slider>
                        <TextBlock x:Name="NowAtherTimeTb"
                                   Text="00:00"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Grid.Column="2">
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,10,0,18">
                        <!--
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel.Transitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </StackPanel.Transitions>
                            <ToggleButton x:Name="LrcButton" Padding="12" Width="44" Height="44"
                                          Checked="LrcButton_Checked" Unchecked="LrcButton_Unchecked"
                                          Background="Transparent" BorderThickness="0" FontWeight="Normal">
                                <FontIcon Glyph="词" FontSize="14" FontFamily="{StaticResource ContentControlThemeFontFamily}"/>
                            </ToggleButton>
                        </StackPanel>-->
                        <Grid VerticalAlignment="Center">
                            <Grid.Transitions>
                                <TransitionCollection>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </Grid.Transitions>
                            <ScrollViewer  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                                           HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                           HorizontalAlignment="Stretch" Background="{x:Null}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <StackPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                            <Setter Property="CornerRadius" Value="100"/>
                                            <Setter Property="Height" Value="44"/>
                                            <Setter Property="Width" Value="44"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{ThemeResource CircleElevationBorderBrush}"/>
                                        </Style>
                                        <Style TargetType="FontIcon">
                                            <Setter Property="FontSize" Value="16"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button x:Name="BeforeButton" Padding="12"
                                            IsEnabled="{Binding ElementName=PlayButton, Path=IsEnabled}"
                                            FontWeight="Normal" Click="BeforeButton_Click"
                                            ToolTipService.ToolTip="上一首">
                                        <Path Data="{StaticResource 上一首}"
                                              Fill="{ThemeResource ButtonForegroundThemeBrush}"
                                              Stretch="UniformToFill" Margin="2"/>
                                    </Button>
                                    <Button x:Name="PlayButton" Width="50" Height="50"
                                            FontWeight="Normal" Click="PlayButton_Click"
                                            ToolTipService.ToolTip="播放/暂停">
                                        <Grid>
                                            <controls:MediaPlayStateViewer x:Name="MediaPlayStateViewer1" PlaybackState="Paused" Margin="12">
                                                <!--<controls:MediaPlayStateViewer.Resources>
                                                    <StaticResource x:Key="ApplicationForegroundThemeBrush" ResourceKey="AccentBrush"/>
                                                </controls:MediaPlayStateViewer.Resources>-->
                                            </controls:MediaPlayStateViewer>
                                            <ProgressRing x:Name="AudioLoadingProressRing" Width="48" Height="48" IsIndeterminate="True" Foreground="{ThemeResource AccentBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NextButton" Padding="12" Width="44" Height="44"
                                            IsEnabled="{Binding ElementName=PlayButton, Path=IsEnabled}"
                                            FontWeight="Normal" Click="NextButton_Click"
                                            ToolTipService.ToolTip="下一首">
                                        <Path Data="{StaticResource 下一首}"
                                              Fill="{ThemeResource ButtonForegroundThemeBrush}"
                                              Stretch="UniformToFill" Margin="2"/>
                                    </Button>
                                    <Button x:Name="VolumeButton" AccessKey="V" Click="VolumeButton_Click" ToolTipService.ToolTip="音频">
                                        <Grid>
                                            <FontIcon Glyph="&#xE995;" Opacity="{ThemeResource VolumeOpacity}"/>
                                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE995;"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="PlayListButton" AccessKey="L" Click="PlayListButton_Click" ToolTipService.ToolTip="正在播放列表">
                                        <FontIcon Glyph="&#xE90B;"/>
                                    </Button>
                                    <Button x:Name="EqButton" AccessKey="E" Click="EqButton_Click" ToolTipService.ToolTip="音频设置">
                                        <FontIcon Glyph="&#xE9E9;"/>
                                    </Button>
                                    <Button x:Name="FullScreenButton" AccessKey="F" Click="FullScreenButton_Click" ToolTipService.ToolTip="全屏/退出全屏">
                                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Button x:Name="CloseMusicPageButton" Click="Button_Click"
                Background="Transparent" BorderBrush="Transparent"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                HorizontalContentAlignment="Left" CornerRadius="0,0,4,0"
                Width="84" Height="48" Padding="12" BorderThickness="0,1,1,1"
                AccessKey="B"
                ToolTipService.ToolTip="关闭音乐界面">
            <AnimatedIcon>
                <AnimatedIcon.Source>
                    <m:AnimatedChevronDownSmallVisualSource/>
                </AnimatedIcon.Source>
            </AnimatedIcon>
        </Button>
        <Button
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Content="..." Opacity=".4"
            BorderThickness="0"
            Background="Transparent">
            <Button.Flyout>
                <Flyout>
                    <ScrollViewer>
                        <StackPanel Orientation="Vertical" Margin="4,0,16,0" Width="250">
                            <Slider Header="透明度" Minimum="0" Maximum="1" Value="{x:Bind AudioSpectrum1.Opacity, Mode=TwoWay}" StepFrequency="0.01"/>
                            <Slider Header="线段宽度" Minimum="0" Maximum="10.0" Value="{x:Bind AudioSpectrum1.StrokeWidth, Mode=TwoWay}" StepFrequency="0.1"/>
                            <Slider Header="斜率(dB/oct)" Minimum="-6" Maximum="6" Value="{x:Bind AudioSpectrum1.TiltDbPerOct, Mode=TwoWay}" StepFrequency="0.1"/>
                            <Slider Header="频谱平滑值" Minimum=".05" Maximum="1.0" Value="{x:Bind AudioSpectrum1.SmoothingFactor, Mode=TwoWay}" StepFrequency="0.01"/>
                            <Slider Header="滑动窗口平滑" Minimum="1" Maximum="100" Value="{x:Bind AudioSpectrum1.SmoothWindow, Mode=TwoWay}" StepFrequency="1"/>
                            <Slider Header="采样数" Minimum="3" Maximum="4096" Value="{x:Bind AudioSpectrum1.SampleCount, Mode=TwoWay}" StepFrequency="1"/>
                            <Slider Header="均衡器影响曲线宽度" Minimum="0" Maximum="10.0" Value="{x:Bind AudioSpectrum1.DrawEqLinesStrokeWidth, Mode=TwoWay}" StepFrequency="0.1"/>
                            <Slider Header="均衡器控制点半径" Minimum="0" Maximum="20.0" Value="{x:Bind AudioSpectrum1.DrawEqPointsRadius, Mode=TwoWay}" StepFrequency="0.1"/>
                            <ui:HeaderedItemsControl 
                                        Header="最小/最大频率(Hz)">
                                <ui:RangeSelector
                                            Minimum="20" Maximum="22000" Visibility="Visible"
                                            RangeStart="{x:Bind AudioSpectrum1.MinFreq, Mode=TwoWay}"
                                            RangeEnd="{x:Bind AudioSpectrum1.MaxFreq, Mode=TwoWay}"/>
                            </ui:HeaderedItemsControl>
                            <CheckBox IsChecked="{x:Bind AudioSpectrum1.DrawDbLines, Mode=TwoWay}" Content="绘制分贝/频率线条"/>
                            <CheckBox IsChecked="{x:Bind AudioSpectrum1.DrawEqLines, Mode=TwoWay}" Content="绘制均衡器影响曲线"/>
                            <CheckBox IsChecked="{x:Bind AudioSpectrum1.DrawEqPoints, Mode=TwoWay}" Content="绘制均衡器控制点"/>
                        </StackPanel>
                    </ScrollViewer>
                </Flyout>
            </Button.Flyout>
        </Button>
        <Grid
            x:Name="Debug_Root"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="8">
            <Rectangle
                x:Name="Debug_NowTimingChangeEventLight"
                RadiusX="4" RadiusY="4"
                Fill="{ThemeResource AccentBrush}"/>
            <TextBlock
                x:Name="Debug_NowPlayingDurationText"
                IsHitTestVisible="False" Margin="8,4"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                HorizontalAlignment="Center" Text="asdasda"/>
        </Grid>
    </Grid>
</Page>
